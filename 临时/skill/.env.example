# ============================================================
# 数据库凭证模板 —— 复制本文件为 .env 并填入真实值
#   cp .env.example .env
# .env 已在 .gitignore 中, 不会进版本库 / 不随 skill 分发。
# 脚本(lib/db_router.py, strategy-mining/lib/db_connector.py 等)启动时
# 会自动加载同目录或上层的 .env, agent 直接调用即可连库, 无需手动 export。
# ============================================================

# ---- Hive (Impala/Trino 协议, PyHive) ----
HIVE_HOST=
HIVE_PORT=10009
HIVE_USER=
HIVE_PASSWORD=
HIVE_USER_ALT=
HIVE_PASSWORD_ALT=
HIVE_DATABASE=default
HIVE_AUTH=PLAIN

# ---- StarRocks (MySQL 协议, PyMySQL) ----
SR_HOST=
SR_PORT=9030
SR_USER=
SR_PASSWORD=
SR_CATALOG=hc2

# ---- strategy-mining 专用 (db_connector.py) ----
SM_SR_HOST=
SM_SR_PORT=19030
SM_SR_USER=
SM_SR_PASSWORD=
SM_HIVE_HOST=
SM_HIVE_PORT=10009
SM_MODEL_PY_USER=
SM_MODEL_PY_PASSWORD=
SM_ZHENGCE_PY_USER=
SM_ZHENGCE_PY_PASSWORD=
SM_CATALOG=hc2

# ---- strategy-analysis / table-explorer (data_loader.py, config.yaml) ----
SA_SR_HOST=
SA_SR_PORT=19030
SA_SR_USER=
SA_SR_PASSWORD=
IMPALA_HOST=
IMPALA_PORT=10009
IMPALA_USER=
IMPALA_PASSWORD=
