# ===== LLM 配置(复制本文件为 .env 并填入真实值)=====
# 你们内部大模型网关
LLM_BASE_URL=https://llmapi.lovbrowser.com
# 调用用的 API Key(必填)
LLM_API_KEY=在这里填你的key
# 模型名(建议用不带"思考"的快模型;实测 claude-haiku-4-5 约 2~6s,推理类模型 15~30s)
LLM_MODEL=claude-haiku-4-5-20251001
# OpenAI 兼容的聊天接口路径(大多数网关是 /v1/chat/completions,一般不用改)
LLM_CHAT_PATH=/v1/chat/completions
# 单次请求超时(秒)
LLM_TIMEOUT=30

# ===== ASR 配置 =====
ASR_MODEL=paraformer-zh-streaming
ASR_SAMPLE_RATE=16000
ASR_DEVICE=cpu

# ===== 有效语音判定 =====
# 绝对下限(RMS);实际阈值 = max(下限, 环境底噪 × VAD_NOISE_RATIO),自动适配麦克风
VAD_SILENCE_RMS=0.004
VAD_NOISE_RATIO=3.0
# 连续静音多少毫秒算一句话结束
VAD_SILENCE_MS=800

# ===== 三大模块热键(各一个,按一下开始录,再按一下结束出稿)=====
HOTKEY_DICTATE=<ctrl>+<alt>+d      # 1.口述转写+润色
HOTKEY_TRANSLATE=<ctrl>+<alt>+t    # 2.翻译
HOTKEY_ASK=<ctrl>+<alt>+a          # 3.问问题
# 翻译目标语言
TRANSLATE_TARGET=英语

# ===== 输出 =====
# type=敲到光标处  print=只打印(调试)
OUTPUT_MODE=type
# paste=剪贴板+Ctrl+V(中文推荐)  key=逐字键入(备用)
INJECT_METHOD=paste

# ===== 浮窗(屏幕下方状态提示)=====
# true=显示录音音量条/思考中/没听清浮窗  false=关闭
SHOW_FLOATING_BAR=true

# ASR 识别语言(当前模型以中文为主)
LANG=zh
